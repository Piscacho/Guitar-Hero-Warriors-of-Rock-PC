// Recursos del ejecutable (sesion 24): icono propio (tools/make_icon.py) e informacion de version.
// Se compila con llvm-rc a gh6.res (tools\build_game.bat) sin cabeceras de Windows: rc.exe se colgaba dentro de la compilacion.
// Constantes de winver.h: VS_VERSION_INFO = 1, VOS_NT_WINDOWS32 = 0x40004, VFT_APP = 1.

1 ICON "gh6.ico"

1 VERSIONINFO
FILEVERSION 1,4,0,0
PRODUCTVERSION 1,4,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "FileDescription", "Guitar Hero: Warriors of Rock - recompilacion para PC"
            VALUE "FileVersion", "1.4.0"
            VALUE "InternalName", "GH6WoR"
            VALUE "OriginalFilename", "GH6WoR.exe"
            VALUE "ProductName", "GH6WoR (recompilacion estatica, no oficial)"
            VALUE "ProductVersion", "1.4.0"
            VALUE "Comments", "Requiere el ISO original de Xbox 360. No contiene archivos del juego."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200
    END
END
